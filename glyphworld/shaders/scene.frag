#version 330
in vec2 uv;
layout(location=0) out vec4 scene_color;
layout(location=1) out vec4 scene_info;
uniform vec2 resolution;
uniform float time;
uniform float camera_x;
uniform float zoom;
uniform float character_x;
uniform float phase;
uniform float bob;
uniform float seed;
uniform bool rain;
uniform bool lighting;
uniform vec3 accent;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1,311.7))+seed)*43758.5453); }
float noise(vec2 p) {
    vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
    return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),
               mix(hash(i+vec2(0,1)),hash(i+1.),f.x),f.y);
}
float box(vec2 p, vec2 c, vec2 h) {
    vec2 d=abs(p-c)-h; return length(max(d,0.))+min(max(d.x,d.y),0.);
}
float segment(vec2 p, vec2 a, vec2 b) {
    vec2 v=b-a; return length(p-a-v*clamp(dot(p-a,v)/dot(v,v),0.,1.));
}
void main() {
    float aspect=resolution.x/resolution.y;
    vec2 q=vec2((uv.x-.5)*aspect,uv.y-.5)/zoom+vec2(0,.38);
    vec2 p=q+vec2(camera_x,0);
    float material=0., depth=.95;
    vec3 fog=vec3(.075,.16,.19);
    vec3 col=mix(vec3(.11,.23,.25),vec3(.018,.035,.075),smoothstep(.15,1.1,q.y));
    col+=.025*noise(vec2(q.x*3.+time*.018,q.y*6.));
    // Four independently scrolling architectural layers, generated by block index.
    for (int layer=0; layer<4; ++layer) {
        float l=float(layer), par=.16+l*.23;
        vec2 w=q+vec2(camera_x*par,0);
        float span=.31+l*.20;
        float id=floor((w.x+l*.23)/span);
        float x=mod(w.x+l*.23,span)-span*.5;
        float h=.30+hash(vec2(id,l))* .40;
        float base=.02+l*.025;
        float halfw=span*(.31+hash(vec2(id+7.,l))*.12);
        bool inside=abs(x)<halfw && w.y>base && w.y<h;
        // Antennas and rooftop water tanks become part of the same scene buffer.
        bool aerial=abs(x+halfw*.5)<.004 && w.y>h && w.y<h+.09;
        bool tank=box(vec2(x,w.y),vec2(halfw*.30,h+.027),vec2(.038,.027))<0.;
        if(inside || aerial || tank) {
            float weather=noise(vec2(x*75.+id,w.y*28.));
            vec3 surface=mix(vec3(.045,.072,.078),vec3(.15,.23,.23),weather);
            float rib=step(.92,fract((x+halfw)*55.));
            surface+=rib*.045;
            vec2 win=vec2((x+halfw)*22.,(w.y-base)*16.);
            vec2 f=fract(win);
            if(inside && f.x>.21 && f.x<.69 && f.y>.20 && f.y<.74) {
                float occupied=step(.81,hash(floor(win)+vec2(id*9.,l*30.)));
                surface=mix(vec3(.016,.038,.046),accent*(.4+.25*noise(floor(win))),occupied);
                if(f.x>.42 && f.x<.48) surface*=.35;
                material=2.;
            } else material=1.;
            // Crumbling mortar, cracks and hanging vegetation.
            float crack=abs(x-.045*sin(w.y*31.+id)-.02*sin(w.y*73.));
            if(crack<.003 && w.y<h*.9) surface*=.28;
            float vine=abs(x-halfw*.85+.012*sin(w.y*37.+time*.3));
            if(vine<.008 && inside) {surface=vec3(.07,.20,.12); material=3.;}
            col=mix(fog,surface,.24+l*.24);
            depth=.85-l*.20;
        }
    }
    // Close industrial facade on the left side of each courtyard.
    float block=floor((p.x+.65)/2.4);
    float bx=mod(p.x+.65,2.4)-.65;
    float wallnoise=noise(vec2(bx*40.,p.y*25.));
    if(bx<-.32 && p.y>.095 && p.y<.92) {
        col=mix(vec3(.055,.09,.095),vec3(.20,.28,.265),wallnoise);
        material=1.; depth=.20;
        vec2 brick=vec2(bx*38.+floor(p.y*38.)*.5,p.y*38.);
        if(fract(brick.x)<.055 || fract(brick.y)<.05) col*=.55;
        vec2 window=vec2(mod(bx+.65,.19)-.095,mod(p.y-.18,.22)-.11);
        if(abs(window.x)<.061 && abs(window.y)<.075 && p.y>.25) {
            col=vec3(.014,.035,.043);
            if(abs(window.x)<.003 || abs(window.y)<.003) col=vec3(.16,.24,.23);
            if(window.y<-.066) col+=vec3(.08,.10,.07);
        }
        float pipe=abs(bx+.36);
        if(pipe<.014) {col=vec3(.14,.19,.18)*(1.-pipe*40.); material=2.;}
        float crack=abs(bx+.46+.018*sin(p.y*40.)+.009*sin(p.y*92.));
        if(crack<.003) col*=.25;
        float vine=abs(bx+.33+.015*sin(p.y*30.+sin(time*.5)*.5));
        if(vine<.009 || (vine<.041 && fract(p.y*43.)<.30)) {
            col=vec3(.11,.29,.16)*(0.6+wallnoise); material=3.;
        }
    }
    // Elevated catwalk: deck, railing, cross-braces and dangling cable.
    float bridgeY=.42;
    if(bx>-.32 && bx<.63) {
        float rail=abs(p.y-(bridgeY+.055));
        float post=abs(mod(bx+.32,.11)-.055);
        bool metal=abs(p.y-bridgeY)<.012 ||
          (rail<.003) || (post<.003 && p.y>bridgeY && p.y<bridgeY+.055);
        float braces=abs(p.y-(bridgeY-.045+abs(mod(bx,.18)-.09)*.5));
        if(braces<.004 && p.y<bridgeY) metal=true;
        if(metal) {col=vec3(.15,.24,.23); material=2.; depth=.27;}
        float cable=bridgeY-.035-.12*sin((bx+.32)/.95*3.14159);
        if(abs(p.y-cable)<.002) {col=vec3(.13,.18,.17); material=2.; depth=.28;}
    }
    // Foreground ground, damp slabs, puddles and rusted drain channels.
    if(p.y<.095) {
        float grain=noise(p*95.);
        col=mix(vec3(.025,.05,.06),vec3(.12,.20,.19),grain);
        material=1.; depth=.10;
        if(p.y>.080) col=vec3(.22,.29,.25)*(0.7+grain*.4);
        if(p.y<.055 && noise(vec2(p.x*7.,p.y*40.))>.47) {
            float ripple=sin(p.x*61.+p.y*190.+time*3.);
            col=vec3(.08,.23,.27)*(0.6+ripple*.25);
            material=4.;
        }
        if(abs(mod(p.x,.17)-.085)<.003) col*=.35;
    }
    // Reeds and ferns, persistent world-space roots, gentle wind.
    float plantId=floor(p.x*14.);
    float root=(plantId+.5)/14.;
    float height=.025+.08*hash(vec2(plantId,8.));
    float py=p.y-.095;
    float sway=sin(time*1.3+plantId)*py*.13;
    float stem=abs(p.x-root-sway);
    if(py>0. && py<height && hash(vec2(plantId,3.))>.35) {
        float leaves=abs(stem- .018*(1.-py/height)*abs(sin(py*190.)));
        if(stem<.002 || leaves<.004) {
            col=mix(vec3(.045,.13,.085),vec3(.22,.40,.20),py/height);
            material=3.; depth=.08;
        }
    }
    // Original small wanderer: hood, tapering coat, animated legs, scarf.
    vec2 c=p-vec2(character_x,.098+bob);
    float walk=sin(phase)*.014;
    bool body=box(c,vec2(0,.040),vec2(.014,.022))<0.;
    bool head=length((c-vec2(.002,.070))/vec2(.019,.020))<1.;
    bool legs=segment(c,vec2(-.007,.025),vec2(-.009+walk,.002))<.004 ||
              segment(c,vec2(.007,.025),vec2(.009-walk,.002))<.004;
    float scarfY=.052+.006*sin(c.x*70.+time*4.);
    bool scarf=c.x<-.010 && c.x>-.065 && abs(c.y-scarfY)<.004;
    if(body||head||legs||scarf) {
        col=scarf?accent*.95:vec3(.60,.76,.67);
        if(head && c.x>.002 && c.y<.077 && c.y>.063) col=vec3(.035,.09,.10);
        if(head && length(c-vec2(.011,.071))<.003) col=vec3(.9,.88,.5);
        material=5.; depth=.04;
    }
    if(lighting) {
        float moon=exp(-length((q-vec2(.35,.72))*vec2(1.1,1.4))*2.8);
        col*=.70+moon*.75;
        float lamp=exp(-length((vec2(bx,p.y)-vec2(-.29,.31))*vec2(2.,1.))*8.);
        col+=accent*lamp*.27;
        if(length(vec2(bx,p.y)-vec2(-.29,.31))<.008) col=accent*1.4;
        // Broad architectural shade, applied before glyph selection.
        col*=1.-.25*step(bx,-.20)*smoothstep(.12,.32,p.y);
    }
    // Three rain depths, no screen-space particle objects or visible sprites.
    if(rain) {
        for(int layer=0;layer<3;++layer) {
            float l=float(layer), scale=55.+l*24.;
            vec2 r=vec2(q.x+q.y*.16+camera_x*(.4+l*.2),q.y+time*(.35+l*.17))*scale;
            vec2 cell=floor(r); vec2 f=fract(r);
            float drop=step(.82,hash(vec2(cell.x,floor(cell.y*.13)+l*80.)));
            float line=(1.-smoothstep(.018,.065,abs(f.x-.5)))*step(.48,f.y)*drop;
            col+=vec3(.20,.35,.39)*line*(.28+l*.2);
            if(line>.3) {material=4.; depth=.03+l*.15;}
        }
    }
    // Atmospheric drift is low-frequency and continuous, not random flicker.
    col+=vec3(.035,.055,.052)*noise(vec2(p.x*3.-time*.04,p.y*8.))*exp(-abs(p.y-.18)*8.);
    col*=1.-.26*smoothstep(.25,.85,length(uv-.5));
    scene_color=vec4(max(col,0.),1.);
    scene_info=vec4(material/8.,depth,noise(p*65.),1.);
}
